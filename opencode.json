{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "lsp": true,
  "agent": {
    "orchestrator": {
      "description": "Project architect and manager. Coordinates all sub-agents for the Authentic Holiday Homes project.",
      "mode": "primary",
      "prompt": "{file:./.opencode/prompts/orchestrator.txt}"
    },
    "explore": {
      "model": "opencode/ling-3.0-flash-free",
      "prompt": "{file:./.opencode/prompts/explore.txt}",
      "permission": {
        "edit": {
          "*": "deny",
          "*.md": "allow"
        }
      }
    }
  }
}